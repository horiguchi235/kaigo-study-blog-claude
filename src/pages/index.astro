---
import Base from '../layouts/Base.astro';
import { categories, subjects, themeIdOf, levelOf, LEVELS, shortTitle, url } from '../data/taxonomy';
import { getArticles } from '../data/articles';
import freq from '../data/freq.json';
import tests from '../data/tests.json';

const articles = await getArticles();
const byTheme = (id: string) => articles.filter((a) => themeIdOf(a.data.theme) === id);
// 大分類に含まれる科目（記事の対応科目から集計）
const subjectsOf = (themeIds: string[]) => {
  const set = new Set<string>();
  articles.filter((a) => themeIds.includes(themeIdOf(a.data.theme))).forEach((a) => a.data.subjects.forEach((s) => set.add(s)));
  return subjects.map((s) => s.name).filter((n) => set.has(n));
};
const yomi = articles.filter((a) => themeIdOf(a.data.theme) === 'Y');
const hikaku = articles.filter((a) => themeIdOf(a.data.theme) === 'Z');
// 最初の記事（STEP 1 の最初のテーマ）
const firstArt = categories.flatMap((c) => c.themes).map((t) => byTheme(t.id)[0]).find(Boolean);
// パート合格（第38回〜）のパートごとの過去問数と、問題ID→パートの対応
const PART: Record<string, string> = {
  人間の尊厳と自立: 'A', 介護の基本: 'A', 社会の理解: 'A', 人間関係とコミュニケーション: 'A', コミュニケーション技術: 'A', 生活支援技術: 'A',
  こころとからだのしくみ: 'B', 発達と老化の理解: 'B', 認知症の理解: 'B', 障害の理解: 'B', 医療的ケア: 'B',
  介護過程: 'C', 総合問題: 'C',
};
const qpart: Record<string, string> = {};
const ptotal: Record<string, number> = { A: 0, B: 0, C: 0 };
for (const list of Object.values(tests as Record<string, any[]>)) for (const q of list) {
  const p = PART[q.sub] ?? PART[String(q.sub).replace(/（.*$/, '')];
  if (!p || qpart[q.id]) continue;
  qpart[q.id] = p; ptotal[p]++;
}
// 勉強の順番（STEP 1 → 6）と、記事ごとの記事末テストの問題数（「次に読む記事」を決めるため）
const order = categories.flatMap((c) => c.themes).flatMap((t) => byTheme(t.id)).map((a) => ({ id: a.id, t: `${a.data.article}：${shortTitle(a.data.title)}`, h: url(`articles/${a.id}/`) }));
const tcount: Record<string, number> = {};
for (const [id, list] of Object.entries(tests as Record<string, any[]>)) tcount[id] = list.length;
---

<Base title="介護福祉士 過去問でつなぐ合格ノート">
  <section class="top-value" aria-label="このサイトの特長">
    <ul>
      <li><b>過去問15年分を論点ごとに分解</b>：何回出たかを数え、よく出る所から科目をまたいで学べます。</li>
      <li><b>記事を読みながら本試験の問題を解く</b>：各記事の最後で、過去5年分の問題をすべて解けます（問題文は試験センター公表の原文のまま）。</li>
      <li><b>ふりがな付きで読める</b>：漢字が苦手な方・外国人の受験者も使えます。記録は登録なしでこの端末に保存。</li>
    </ul>
  </section>
  <section class="top-start" aria-label="勉強をはじめる">
    <p class="ts-count" id="ts-count">第39回試験（2027年1月31日）まで <b>…</b></p>
    <div class="ts-btns">
      <a class="ts-go" id="ts-go" href={firstArt ? url(`articles/${firstArt.id}/`) : url('')}>
        <small id="ts-go-sub">はじめての方</small>
        <span id="ts-go-t">STEP 1 の最初の記事から始める →</span>
      </a>
      <a class="ts-last" id="ts-last" href="#" hidden>
        <small>最後に開いた記事</small>
        <span id="ts-last-t"></span>
      </a>
      <a class="ts-guide" href={url('guide/')}>🔰 このサイトの使い方</a>
    </div>
    <div class="ts-parts" id="ts-parts" hidden>
      <p class="ts-parts-h">過去問5年分の進み具合（パート別）</p>
      <p class="ts-parts-note">試験は3つのパートに分かれます。<b>A</b>＝人間と社会・介護（午前・60問）、<b>B</b>＝こころとからだのしくみ（午後・45問）、<b>C</b>＝介護過程と総合問題（午後・20問）。<a href={url('articles/yomimono-02-zatsugaku/')}>パート合格のしくみ →</a></p>
      {['A', 'B', 'C'].map((p) => (
        <div class="ts-part" data-p={p}><span class="ts-pn">{p}パート</span><span class="ts-bar"><span></span></span><span class="ts-num">0 / {ptotal[p]}</span></div>
      ))}
      <p class="ts-note">記録はこの端末だけに保存されます。<a href={url('mylist/')}>マイリストで書き出せます →</a></p>
    </div>
  </section>
  <script is:inline define:vars={{ qpart, ptotal, order, tcount }}>
    (function () {
      // 試験日までの日数
      var exam = new Date(2027, 0, 31), now = new Date(); now.setHours(0, 0, 0, 0);
      var d = Math.round((exam - now) / 86400000), el = document.getElementById('ts-count');
      if (d > 0) el.innerHTML = '第39回試験（2027年1月31日）まで あと <b>' + d + '日</b>';
      else if (d === 0) el.innerHTML = '今日は第39回試験の日です。がんばって！';
      else el.hidden = true;
      // 次に読む記事＝勉強の順番で、記事末テストをまだ終えていない一番前の記事（テストの途中ならテストの位置へ）
      try {
        var pt0 = JSON.parse(localStorage.getItem('ptest') || '{}');
        var last = JSON.parse(localStorage.getItem('lastArt') || 'null');
        var started = Object.keys(pt0).length > 0;
        if (started) {
          var nx = null, nd = 0;
          for (var k = 0; k < order.length; k++) {
            var o = order[k], tc = tcount[o.id] || 0; if (!tc) continue;
            var r = pt0[o.id], d = r ? Object.keys(r.ans || {}).length : 0;
            if (d < tc) { nx = o; nd = d; break; }
          }
          if (nx) {
            document.getElementById('ts-go').href = nx.h + (nd ? '#ptest' : '');
            document.getElementById('ts-go-sub').textContent = nd ? '前回の続きから（テスト ' + nd + ' / ' + tcount[nx.id] + '問）' : '次に読む記事';
            document.getElementById('ts-go-t').textContent = nx.t + ' →';
          } else {
            document.getElementById('ts-go-sub').textContent = '全記事のテストを終えました 🎉';
            document.getElementById('ts-go-t').textContent = 'まちがえた問題をまとめて解き直す →';
            document.getElementById('ts-go').href = 'mylist/#wrong';
          }
        }
        if (last && last.href && (!started || !nx || last.href.indexOf(nx.id) < 0)) {
          var lk = document.getElementById('ts-last'); lk.hidden = false; lk.href = last.href;
          document.getElementById('ts-last-t').textContent = last.title + ' →';
          if (!started) { lk.querySelector('small').textContent = '前回の続きから（最後に開いた記事）'; }
        }
      } catch (e) {}
      // パート別の進み具合
      try {
        var pt = JSON.parse(localStorage.getItem('ptest') || '{}'), got = { A: 0, B: 0, C: 0 }, any = 0;
        var seen = {};
        Object.keys(pt).forEach(function (id) { Object.keys(pt[id].ans || {}).forEach(function (q) { seen[q] = 1; }); });
        try { var ql = JSON.parse(localStorage.getItem('qlog') || '{}'); Object.keys(ql).forEach(function (q) { seen[q] = 1; }); } catch (e) {}
        Object.keys(seen).forEach(function (q) { var p = qpart[q]; if (p) { got[p]++; any++; } });
        if (any) {
          document.getElementById('ts-parts').hidden = false;
          document.querySelectorAll('.ts-part').forEach(function (row) {
            var p = row.dataset.p, n = got[p], t = ptotal[p] || 1;
            row.querySelector('.ts-bar span').style.width = Math.round(n / t * 100) + '%';
            row.querySelector('.ts-num').textContent = n + ' / ' + ptotal[p];
          });
        }
      } catch (e) {}
    })();
  </script>

  <nav class="top-links" aria-label="ほかの勉強のしかた">
    <a href={url('subjects/')}>科目別目次</a>
    <a href={url('level/')}>重要度別<small>時間がないとき</small></a>
    <a href={url('ichimon/')}>1問1答</a>
    <a href={url('anki/')}>暗記シート</a>
    <a href={url('hikaku/')}>比較で覚える</a>
    <a href={url('moshi/')}>○×クイズ</a>
    <a href={url('mame/')}>豆知識・試験情報</a>
  </nav>

  <h2 class="section-title" id="theme">テーマ別目次</h2>
  <p class="legend-lead">基本はこの順番（STEP 1 → 6）で読み進めます。重要度別・科目別は、時間がないときや苦手科目だけをやりたいとき用です。</p>
  <p class="legend">
    {[3, 2, 1].map((lv) => <span><span class={`lvb lv${lv}`}>{LEVELS[lv].label}</span> {LEVELS[lv].note}</span>)}
  </p>
  <div class="roadmap">
    {
      categories.map((c) => (
        <details class="card" id={`cat-${c.no}`}>
          <summary>
            <h3><span class="step">STEP {c.no}</span>{c.name}</h3>
            <p class="subj">科目：{subjectsOf(c.themes.map((t) => t.id)).join('・')}</p>
          </summary>
          <ul class="theme-list">
            {c.themes.map((t) => {
              const list = byTheme(t.id);
              const lv = levelOf(t.id);
              return (
                <li>
                  <span class={list.length ? 'tname' : 'tname soon'}>{t.name}</span> <span class={`lvb lv${lv}`}>{LEVELS[lv].label}</span>
                  {list.length > 0 && (
                    <ul class="article-links">
                      {list.map((a) => (
                        <li>
                          <a href={url(`articles/${a.id}/`)}>{a.data.article}：{shortTitle(a.data.title)}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </details>
      ))
    }
  </div>

  {
    hikaku.length > 0 && (
      <>
        <h2 class="section-title">比較で覚える</h2>
        <div class="card">
          <ul class="article-links">
            {hikaku.map((a) => <li><a href={url(`articles/${a.id}/`)}>{shortTitle(a.data.title)}</a></li>)}
          </ul>
        </div>
      </>
    )
  }

  {
    yomi.length > 0 && (
      <>
        <h2 class="section-title">豆知識・試験情報</h2>
        <div class="card">
          <ul class="article-links">
            {yomi.map((a) => <li><a href={url(`articles/${a.id}/`)}>{shortTitle(a.data.title)}</a></li>)}
          </ul>
        </div>
      </>
    )
  }

  <h2 class="section-title">科目別に探す</h2>
  <div class="subject-grid">
    {
      subjects.map((s) => (
        <a href={url(`subjects/${s.slug}/`)}>
          {s.name}
          <small>{s.group}</small>
        </a>
      ))
    }
  </div>
</Base>
