---
import Base from '../layouts/Base.astro';
import { categories, subjects, themeIdOf, levelOf, LEVELS, shortTitle, url } from '../data/taxonomy';
import { getArticles } from '../data/articles';
import freq from '../data/freq.json';

const articles = await getArticles();
const byTheme = (id: string) => articles.filter((a) => themeIdOf(a.data.theme) === id);
// 大分類に含まれる科目（記事の対応科目から集計）
const subjectsOf = (themeIds: string[]) => {
  const set = new Set<string>();
  articles.filter((a) => themeIds.includes(themeIdOf(a.data.theme))).forEach((a) => a.data.subjects.forEach((s) => set.add(s)));
  return subjects.map((s) => s.name).filter((n) => set.has(n));
};
const yomi = articles.filter((a) => themeIdOf(a.data.theme) === 'Y');
const hikaku = articles.filter((a) => themeIdOf(a.data.theme) === 'Z');
---

<Base title="介護福祉士 過去問でつなぐ合格ノート">
  <a class="guide-hero" href={url('guide/')}>
    <span class="gh-badge">🔰 はじめての方へ</span>
    <span class="gh-title">このサイトの使い方・勉強のしかた</span>
    <span class="gh-sub">AIが過去問15年分を分析して作った教材です。まずはここから →</span>
  </a>

  <p class="top-progress" id="top-progress" hidden></p>
  <script is:inline define:vars={{ total5: (freq as any).total5 ?? 0, mylist: url('mylist/') }}>
    try {
      var pt = JSON.parse(localStorage.getItem('ptest') || '{}'), n = 0;
      Object.keys(pt).forEach(function (id) { n += Object.keys(pt[id].ans || {}).length; });
      if (n) { var el = document.getElementById('top-progress'); el.hidden = false; el.innerHTML = '✏️ 過去問5年分：<b>' + n + ' / ' + total5 + '問</b> 解きました <a href="' + mylist + '">記録を見る →</a>'; }
    } catch (e) {}
  </script>

  <h2 class="section-title">勉強のしかたを選ぶ</h2>
  <div class="menu-grid">
    <a href="#theme">📚 テーマ別目次<small>科目の壁なし・重複なしで効率よく</small></a>
    <a href={url('subjects/')}>🗂 科目別目次<small>13科目から探す</small></a>
    <a href={url('level/')}>⭐ 重要度別<small>よく出る順に効率よく</small></a>
    <a href={url('ichimon/')}>📝 1問1答<small>○×ですき間時間に</small></a>
    <a href={url('anki/')}>🔴 暗記シート<small>かくして覚える・印刷も</small></a>
    <a href={url('hikaku/')}>⚖️ 比較で覚える<small>似ている制度の違い</small></a>
    <a href={url('moshi/')}>⏱ ミニ模試<small>ランダム20問で力だめし</small></a>
    <a href={url('mame/')}>💡 豆知識・試験情報<small>傾向・パート合格など</small></a>
  </div>

  <h2 class="section-title" id="theme">テーマ別目次</h2>
  <p class="legend">
    {[3, 2, 1].map((lv) => <span><span class={`lvb lv${lv}`}>{LEVELS[lv].label}</span> {LEVELS[lv].note}</span>)}
  </p>
  <div class="roadmap">
    {
      categories.map((c) => (
        <details class="card" id={`cat-${c.no}`}>
          <summary>
            <h3><span class="step">STEP {c.no}</span>{c.name}</h3>
            <p class="subj">科目：{subjectsOf(c.themes.map((t) => t.id)).join('・')}</p>
          </summary>
          <ul class="theme-list">
            {c.themes.map((t) => {
              const list = byTheme(t.id);
              const lv = levelOf(t.id);
              return (
                <li>
                  <span class={list.length ? 'tname' : 'tname soon'}>{t.name}</span> <span class={`lvb lv${lv}`}>{LEVELS[lv].label}</span>
                  {list.length > 0 && (
                    <ul class="article-links">
                      {list.map((a) => (
                        <li>
                          <a href={url(`articles/${a.id}/`)}>{a.data.article}：{shortTitle(a.data.title)}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </details>
      ))
    }
  </div>

  {
    hikaku.length > 0 && (
      <>
        <h2 class="section-title">比較で覚える</h2>
        <div class="card">
          <ul class="article-links">
            {hikaku.map((a) => <li><a href={url(`articles/${a.id}/`)}>{shortTitle(a.data.title)}</a></li>)}
          </ul>
        </div>
      </>
    )
  }

  {
    yomi.length > 0 && (
      <>
        <h2 class="section-title">豆知識・試験情報</h2>
        <div class="card">
          <ul class="article-links">
            {yomi.map((a) => <li><a href={url(`articles/${a.id}/`)}>{shortTitle(a.data.title)}</a></li>)}
          </ul>
        </div>
      </>
    )
  }

  <h2 class="section-title">科目別に探す</h2>
  <div class="subject-grid">
    {
      subjects.map((s) => (
        <a href={url(`subjects/${s.slug}/`)}>
          {s.name}
          <small>{s.group}</small>
        </a>
      ))
    }
  </div>
</Base>
