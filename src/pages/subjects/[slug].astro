---
import Base from '../../layouts/Base.astro';
import { getArticles, type Article } from '../../data/articles';
import { categories, subjects, themeIdOf, url, levelOf, LEVELS, type Subject } from '../../data/taxonomy';

export async function getStaticPaths() {
  const articles = await getArticles();
  return subjects.map((s) => ({ params: { slug: s.slug }, props: { s, articles } }));
}

const { s, articles } = Astro.props as { s: Subject; articles: Article[] };
const mine = articles.filter((a) => a.data.subjects.includes(s.name));
const covered = mine.reduce((sum, a) => sum + (a.data.subject_questions[s.name] ?? 0), 0);

// 勉強順（大分類の順）に並べる
const order = (a: Article) => {
  const id = themeIdOf(a.data.theme);
  return categories.findIndex((c) => c.themes.some((t) => t.id === id));
};
const groups = categories
  .map((c, i) => ({ c, list: mine.filter((a) => order(a) === i) }))
  .filter((g) => g.list.length > 0);
---

<Base title={`${s.name}の目次`} description={`介護福祉士試験「${s.name}」の過去問を、テーマ別の記事で対策するための目次ページ。`}>
  <section class="hero">
    <p class="breadcrumb"><a href={url('subjects/')}>科目別目次</a> › {s.group}</p>
    <h1>{s.name}の目次</h1>
    <p>このブログは科目を横断したテーマ別に解説しているので、「{s.name}」の内容が含まれる記事をここにまとめています。この目次から読むと、記事の下の「次の記事」もこの科目の順番で進みます。</p>
  </section>

  {
    mine.length === 0 ? (
      <div class="card"><p class="lead">この科目の記事は準備中です。</p></div>
    ) : (
      <>
        {groups.map((g) => (
          <div class="card">
            <h3><span class="step">STEP {g.c.no}</span>{g.c.name}</h3>
            <ul class="theme-list">
              {g.list.map((a) => (
                <li>
                  <a href={url(`articles/${a.id}/?from=s-${s.slug}`)}>{a.data.article}：{a.data.title.split('｜')[0]}</a>
                  <span class={`lvb lv${levelOf(themeIdOf(a.data.theme))}`}>{LEVELS[levelOf(themeIdOf(a.data.theme))].label}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </>
    )
  }
</Base>
