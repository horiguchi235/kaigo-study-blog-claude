---
import Base from '../../layouts/Base.astro';
import { subjects, url } from '../../data/taxonomy';

---

<Base title="科目別目次" description="介護福祉士試験の12科目ごとに、対応する記事をまとめた目次。">
  <section class="hero">
    <h1>科目別目次</h1>
    <p>科目ごとに勉強したい人のための入口です。各科目の内容が含まれるテーマ記事を、勉強する順に並べています。</p>
  </section>
  <div class="subject-grid subject-grid-12">
    {
      subjects.map((s, i) => (
        <a href={url(`subjects/${s.slug}/`)}>
          <span class="sg-no">{i + 1}</span>
          <span class="sg-name">{s.name}</span>
        </a>
      ))
    }
  </div>
</Base>
