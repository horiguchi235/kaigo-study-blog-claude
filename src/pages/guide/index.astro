---
// はじめての方へ：このサイトを使った勉強のしかた
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import GuideSlides from '../../components/GuideSlides.astro';
import { LEVELS, url } from '../../data/taxonomy';
import { getArticles } from '../../data/articles';
import { studyOf } from '../../data/study';
import freq from '../../data/freq.json';

const articles = await getArticles();
const total5 = (freq as any).total5 ?? 0;
const qa = articles.reduce((n, a) => n + (studyOf(a.id)?.qa.length ?? 0), 0);
const img = (n: string) => url(`images/guide/${n}.webp`);
// スケジュールの絵は差し替え待ち。ファイルがあるときだけ表示する
const hasSchedule = fs.existsSync('public/images/guide/schedule.webp');

const types = [
  { href: url(''), img: 'type-theme', tag: 'おすすめ', title: '時間がない・効率よく全体を押さえたい',
    text: '<b>テーマ別目次</b>の STEP 1 から順に。13科目の“科目の壁”をなくし、何度も出てくる同じ内容を1か所にまとめているので、<b>同じことを科目ごとにくり返し覚えるムダがありません</b>。1日1記事が目安です。' },
  { href: url('level/'), img: 'type-level', title: '試験まであと少し・とにかく点を取りたい',
    text: `<b>重要度別</b>の「${LEVELS[3].label} ${LEVELS[3].stars}」から。毎年のように出るテーマだけを先に固めて、得点の土台を作ります。` },
  { href: url('subjects/'), img: 'type-subject', title: '苦手な科目がはっきりしている',
    text: '<b>科目別目次</b>から、その科目の記事だけを集中して。模試や過去問で点が低かった科目から始めましょう。' },
  { href: url('level/'), img: 'type-moshi', title: '実務者研修を終えた・ひととおり勉強した',
    text: '<b>重要度別</b>から記事を選び、記事の最後の<b>過去問テスト</b>で力だめし。まちがえた問題の見出しに戻ると、弱点だけを効率よく埋められます。' },
  { href: url('ichimon/'), img: 'type-sukima', title: 'まとまった時間がとれない',
    text: 'スマホで<b>1問1答</b>と<b>暗記シート</b>。5分あれば1記事ぶんの要点をくり返せます。週末に記事を1本読む、と組み合わせると効果的です。' },
  { href: '#lang', img: 'type-lang', title: '日本語の漢字が苦手・EPA候補者の方',
    text: '右上の 🌐 で<b>ふりがな</b>や<b>英語・インドネシア語・フィリピン語・ベトナム語</b>に切り替えられます。' },
];

const cycles = [
  { img: 'cycle-1', title: '1周目：読んで分かる', text: '覚えようとしなくて大丈夫。「なぜそうなるか」と「こう聞かれる」をつかむのが目的です。' },
  { img: 'cycle-2', title: '2周目：かくして覚える', text: '記事の「暗記モード」や「暗記シート」で、大事な言葉・数字をかくして思い出す練習をします。' },
  { img: 'cycle-3', title: '3周目：解いて確かめる', text: '記事の最後の「過去問テスト」で、まちがえた問題だけをくり返します。1問1答・○×クイズも組み合わせると、解く力が安定します。' },
];

const readSlides = [
  { img: 'shot-01', title: '最初に「過去5年の出題数」', chara: 'ai-analysis',
    text: '記事のはじめに、この記事から過去5年で何問出たか、どの論点が何問かが棒グラフで出ます。<b>棒が長いところほどしっかり読みましょう。</b>' },
  { img: 'shot-02', title: '見出しをタップして開く', chara: 'type-lang',
    text: '最初は見出しだけが目次のように並んでいます。読みたい見出しをタップすると中身が開きます。「すべて開く」で全部まとめて読むこともできます。' },
  { img: 'shot-03', title: 'マーカーの太字＝試験に出る言葉', chara: 'cycle-1',
    text: 'マーカーのついた太字は、<b>過去問で実際に問われた言葉や数字</b>です。ここを優先して覚えましょう。表や囲みで「なぜそうなるか」も説明しています。' },
  { img: 'shot-04', title: '✏️ 過去問を解いてみよう', chara: 'type-moshi',
    text: '見出しのあとに、その内容が出た過去問があります。「第○回：科目名」を選んで解き、「正解を見る」で答え合わせ。<b>読んだ直後に本番の聞かれ方を確認</b>できます。' },
  { img: 'shot-05', title: '📝 この記事の過去問テスト', chara: 'cycle-3',
    text: `記事のいちばん最後に、その記事から出た過去5年分の問題がすべてあります。1問ずつ答え合わせと解説が出て、まちがえた問題だけ解き直せます。<b>全部の記事のテストで${total5}問</b>になります。` },
  { img: 'shot-06', title: '🙈 暗記モード', chara: 'cycle-2',
    text: '記事の上の「暗記モード」を押すと、大事な太字がオレンジの帯でかくれます。タップすると1つずつ表示。<b>2周目の思い出す練習</b>に使います。' },
];

const toolSlides = [
  { img: 'shot-07', title: '🔴 暗記シート', chara: 'type-level',
    text: '記事の要点だけをまとめたページです。「おすすめの所をまとめてかくす」で赤シートのように使えます。自分でかくす所を選ぶことも、<b>印刷</b>することもできます。' },
  { img: 'shot-08', title: `📝 1問1答（全${qa}問）`, chara: 'type-sukima',
    text: '記事から作った○×・思い出し問題です。「答えを見る」→「覚えていた／まだ」で記録され、<b>まちがえた問題だけ</b>をくり返せます。通勤や休憩の5分に。' },
  { img: 'shot-09', title: '⭐ マイリスト', chara: 'type-theme',
    text: '記事の上の「お気に入り・復習・苦手」の印と、過去問テストの進み具合がここに集まります。<b>解いた問題数と正答率</b>もひと目で分かります。' },
];
---

<Base title="このサイトの使い方・勉強のしかた" description="AIが過去15年分の本試験を分析して作った介護福祉士の教材。自分に合った始め方、記事の読み方、暗記モード・1問1答・○×クイズの使い分けと、スケジュール例。">
  <article class="article guide">
    <p class="breadcrumb"><a href={url('')}>テーマ別目次</a> › このサイトの使い方</p>

    <div class="gd-hero">
      <img src={img('hero')} alt="休憩室でスマホを使って勉強する女の子" width="1200" height="800" />
      <div class="gd-hero-text">
        <h1>🔰 このサイトの使い方・勉強のしかた</h1>
        <p>すき間時間でも、<b>出るところから</b>まっすぐ。<br />はじめての方はここから読んでください。</p>
      </div>
    </div>

    <nav class="gd-toc" aria-label="このページの目次">
      <a href="#about">このサイトについて</a><a href="#start">① 始め方</a><a href="#cycle">② 3周で仕上げる</a><a href="#read">③ 記事の読み方</a><a href="#tools">④ 覚える道具</a><a href="#schedule">⑤ スケジュール</a><a href="#tips">⑥ つまずいたとき</a><a href="#lang">⑦ ふりがな・外国語</a>
    </nav>

    <section class="guide-lead" id="about">
      <div class="gd-ai">
        <img src={img('ai-analysis')} alt="たくさんの問題用紙を虫めがねで調べて、色分けしたカードに整理する女の子" width="1000" height="667" loading="lazy" />
        <p class="gl-big">このサイトは、<strong>AIが過去15年分・約1,800問の本試験を1問ずつ分析</strong>して作った教材です。</p>
      </div>
      <p>「どの知識が、何回、どんな聞かれ方で出たか」をすべて数えて、<strong>よく出るところから</strong>、<strong>つながりで覚えられる順番</strong>に並べ直しました。参考書を最初から読むより、合格に必要なところへまっすぐ進めます。</p>
      <p class="gl-hero">📝 <b>全部の記事を読んで、記事ごとの過去問テストを解くだけで、<br />過去5年分（第34〜38回）の本試験 {total5}問 をすべて解き終わります。</b><br /><span>どの問題も、その答えの根拠が書いてある記事の最後に置いてあるので、「読む → すぐ解く → まちがえたら読み直す」が1ページで完結します。</span></p>
      <ul class="gl-points">
        <li><b>📊 出る順がひと目で分かる</b><span>記事ごとに「過去5年で何問出たか」を表示。どこに時間をかければいいか迷いません。</span></li>
        <li><b>🔗 13科目を“つないで”理解</b><span>「からだのしくみ → 介助の方法 → 制度」のように、科目をまたいで1つのテーマで学ぶので、丸暗記より忘れにくくなります。</span></li>
        <li><b>✏️ 読んだらすぐ本番の問題</b><span>見出しのすぐ下に代表的な過去問、記事の最後には過去5年分ぜんぶの「過去問テスト」。解いた数と正答率は自動で記録されます。</span></li>
        <li><b>📝 すき間時間で復習</b><span>記事から自動で作った1問1答{qa}問と暗記シート。通勤や休憩の5分でもくり返せます。</span></li>
      </ul>
      <p>働きながらの受験でも大丈夫。<strong>「出るところを、分かって、覚える」</strong>を毎日少しずつ積み重ねれば、合格ラインは見えてきます。</p>
    </section>

    <h2 id="start">① あなたに合った始め方</h2>
    <p>いまの状況に近いものを選んでください。どこから始めても、記事・過去問・1問1答はつながっています。</p>
    <div class="gd-types">
      {types.map((t) => (
        <a class="gd-type" href={t.href}>
          <img src={img(t.img)} alt="" width="520" height="598" loading="lazy" />
          <span class="gd-type-body">
            {t.tag && <em>{t.tag}</em>}
            <b>{t.title}</b>
            <span set:html={t.text} />
            <span class="gd-go">ここから始める →</span>
          </span>
        </a>
      ))}
    </div>

    <h2 id="cycle">② 慣れてきたら：3周で仕上げる</h2>
    <p>どの始め方でも、最終的には次の3段階をくり返すと点数が安定します。</p>
    <ol class="gd-cycle">
      {cycles.map((c) => (
        <li>
          <img src={img(c.img)} alt="" width="520" height="598" loading="lazy" />
          <b>{c.title}</b>
          <span>{c.text}</span>
        </li>
      ))}
    </ol>
    <p>目次はパソコンでは画面の左、スマホでは左下の「☰ 目次」からいつでも開けます。「テーマ別／科目別」で切り替えられます。</p>

    <h2 id="read">③ 記事の読み方</h2>
    <p>実際の画面で見てみましょう。<b>◀ ▶ を押すか、横にスワイプ</b>すると次の画面に進みます。</p>
    <GuideSlides id="gs-read" label="記事の読み方のスライド" slides={readSlides} />
    <ul class="gd-extra">
      <li><b>ひっかけ注意</b>：よくまちがえる選択肢のパターンです。2周目以降に特に役立ちます。</li>
      <li><b>図</b>：からだのしくみや制度の流れは図で確認できます。「次へ ▶」で1枚ずつ進む図もあります。</li>
    </ul>

    <h2 id="tools">④ 覚えるための道具</h2>
    <GuideSlides id="gs-tools" label="覚えるための道具のスライド" slides={toolSlides} />
    <div class="gd-tools">
      <a href={url('anki/')}><b>🔴 暗記シート</b><span>2周目・試験直前</span></a>
      <a href={url('ichimon/')}><b>📝 1問1答</b><span>2〜3周目のすき間時間</span></a>
      <a href={url('hikaku/')}><b>⚖️ 比較で覚える</b><span>似ている制度・病気が混ざったら</span></a>
      <a href={url('moshi/')}><b>⭕ ○×クイズ</b><span>全記事からランダム20問</span></a>
      <a href={url('mylist/')}><b>⭐ マイリスト</b><span>進み具合の確認</span></a>
    </div>

    <h2 id="schedule">⑤ スケジュールの例</h2>
    <p>試験は毎年1月下旬です。働きながら勉強する人を想定した例です。</p>
    {hasSchedule && <img class="gd-wide" src={img('schedule')} alt="夏は本を読み、秋は赤いシートで覚え、冬は問題を解きながら、試験会場へ続く道を進む女の子" width="1200" height="800" loading="lazy" />}
    <ol class="gd-plan">
      <li class="p1"><span class="gd-when">試験の6〜4か月前</span><b>1周目：読んで分かる</b><span>1日1〜2記事を目安に、STEP 1 から順に読む。過去問は解けなくても答えを読んで「こう聞かれるのか」を知るだけでOK。</span></li>
      <li class="p2"><span class="gd-when">4〜2か月前</span><b>2周目：かくして覚える</b><span>暗記モード・暗記シートで覚える。すき間時間に1問1答。</span></li>
      <li class="p3"><span class="gd-when">2か月前〜直前</span><b>3周目：解いて確かめる</b><span>過去問テストと○×クイズで解く練習。まちがえたテーマの記事を読み直す。直前は重要度「{LEVELS[3].label}」の暗記シートを中心に。</span></li>
    </ol>

    <h2 id="tips">⑥ つまずいたときのコツ</h2>
    <div class="gd-tips-banner">
      <img src={img('tips')} alt="マグカップを持って、小さな階段の1段目に足をのせる女の子" width="1100" height="300" loading="lazy" />
      <p>一歩ずつで<br />大丈夫。</p>
    </div>
    <dl class="gd-tips">
      <div><dt>専門用語が分からない</dt><dd>まずは記事の図と「なぜ」の説明だけ読んで、細かい言葉は2周目に回しましょう。1周目で全部覚える必要はありません。</dd></div>
      <div><dt>過去問がまったく解けない</dt><dd>最初はそれがふつうです。答えと解説を読んで、どの見出しの話だったかを確認するだけで力になります。</dd></div>
      <div><dt>数字が覚えられない</dt><dd>暗記シートを印刷して、何度も目にする場所に置いておくのがおすすめです。</dd></div>
      <div><dt>やる気が続かない</dt><dd>「今日はこの見出し1つだけ」と小さく決めると続けやすくなります。</dd></div>
    </dl>

    <h2 id="lang">⑦ ふりがな・外国語（EPA候補者の方へ）</h2>
    <div class="gd-lang">
      <figure class="gs-phone"><img src={img('shot-10')} alt="画面の例：ふりがなを表示した記事" width="600" height="862" loading="lazy" /></figure>
      <ul>
        <li><b>ふりがな</b>：画面右上の「🌐」で「にほんご（ふりがな）」を選ぶと、漢字に読みがながつきます。もう一度「日本語」を選ぶと消えます。</li>
        <li><b>English / Bahasa Indonesia / Filipino / Tiếng Việt</b>：翻訳のある記事は、選んだ言語のページに切り替わります。試験は日本語なので、大事な言葉は「pressure ulcer（褥瘡／じょくそう）」のように日本語と読みも残しています。翻訳はまだ一部の記事だけです。</li>
      </ul>
    </div>

    <p class="guide-start"><a class="btn" href={url('')}>📚 テーマ別目次から始める</a></p>
  </article>
</Base>
