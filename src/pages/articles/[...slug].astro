---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getArticles, type Article } from '../../data/articles';
import { categories, subjectByName, themeIdOf, url } from '../../data/taxonomy';
import { studyOf } from '../../data/study';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((a) => ({ params: { slug: a.id }, props: { a, all: articles } }));
}

const { a, all } = Astro.props as { a: Article; all: Article[] };
const { Content } = await render(a);
const themeId = themeIdOf(a.data.theme);
const category = categories.find((c) => c.themes.some((t) => t.id === themeId));
const study = studyOf(a.id);
const siblings = all.filter((x) => themeIdOf(x.data.theme) === themeId && x.id !== a.id);
---

<Base title={a.data.title} description={a.data.description}>
  <article class="article">
    <p class="breadcrumb">
      <a href={url('')}>学習ロードマップ</a>
      {category && <> › STEP {category.no} {category.name}</>}
      › {a.data.theme.replace(/^T\d+ /, '')}
    </p>
    <h1>{a.data.title}</h1>
    <p class="meta">この記事でカバーする過去問：{a.data.past_questions}問（第24〜38回）</p>
    <ul class="badges">
      {a.data.draft && <li><span class="badge draft">下書き（本番には表示されません）</span></li>}
      {
        a.data.subjects.map((name) => {
          const s = subjectByName(name);
          return <li>{s ? <a class="badge" href={url(`subjects/${s.slug}/`)}>{name}</a> : <span class="badge">{name}</span>}</li>;
        })
      }
    </ul>
    {
      study && (
        <p class="study-links">
          {study.qa.length > 0 && <a href={url(`ichimon/${a.id}/`)}>📝 この記事の1問1答（{study.qa.length}問）</a>}
          <a href={url(`anki/${a.id}/`)}>🔴 暗記シート</a>
          <button type="button" class="mask-toggle" aria-pressed="false">🙈 暗記モード（太字をかくす）</button>
        </p>
      )
    }

    <Content />

    {
      siblings.length > 0 && (
        <>
          <h2>同じテーマの記事</h2>
          <ul>
            {siblings.map((x) => (
              <li>
                <a href={url(`articles/${x.id}/`)}>{x.data.article}：{x.data.title.split('｜')[0]}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </article>
  <script is:inline>
    // 暗記モード：記事の太字をかくし、タップで1つずつ表示する
    (function () {
      var btn = document.querySelector('.mask-toggle'); if (!btn) return;
      var art = document.querySelector('.article');
      btn.addEventListener('click', function () {
        var on = !art.classList.contains('masked');
        art.classList.toggle('masked', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        btn.textContent = on ? '👀 暗記モードを終える' : '🙈 暗記モード（太字をかくす）';
        art.querySelectorAll('strong.shown').forEach(function (s) { s.classList.remove('shown'); });
      });
      art.addEventListener('click', function (e) {
        var s = e.target.closest && e.target.closest('strong');
        if (s && art.classList.contains('masked')) s.classList.toggle('shown');
      });
    })();
  </script>
</Base>
