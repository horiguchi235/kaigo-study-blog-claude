---
import '../styles/global.css';
import { url } from '../data/taxonomy';
import Sidebar from '../components/Sidebar.astro';
import { UI, LANG_MENU, type Lang } from '../data/i18n';

interface Props {
  title: string;
  description?: string;
  themeId?: string;
  articleId?: string;
  // 言語切り替え：lang＝このページの言語、trans＝この記事の翻訳がある言語、jaUrl＝翻訳ページから日本語記事への URL
  lang?: Lang | 'ja';
  trans?: string[];
  jaUrl?: string;
}
const { themeId, articleId, lang = 'ja', trans = [], jaUrl } = Astro.props;
const ui = lang === 'ja' ? null : UI[lang];
const nav = (k: string, ja: string) => (ui ? ui.nav[k] : ja);
const { title, description = '介護福祉士国家試験の過去問15年分を分析し、テーマ別に「しくみ→介助→制度」をつなげて解説する試験対策ブログ。' } = Astro.props;
const siteName = '介護福祉士 過去問でつなぐ合格ノート';
const pageTitle = title === siteName ? title : `${title}｜${siteName}`;
---

<!doctype html>
<html lang={lang} data-page-lang={lang} data-article={articleId ?? ''} data-trans={trans.join(',')} data-ja-url={jaUrl ?? ''} data-base={url('')} data-idx="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // 左目次の開閉・ルビの表示は、描画前に決めてちらつかないようにする
      try {
        if (localStorage.getItem('sideCollapsed')) document.documentElement.classList.add('side-collapsed');
        var pref = localStorage.getItem('lang') || 'ja';
        if (pref === 'ruby') document.documentElement.classList.add('ruby');
        // 外国語を選んでいて、この日本語記事に翻訳があれば翻訳ページへ
        var h = document.documentElement, t = (h.dataset.trans || '').split(',');
        if (h.dataset.pageLang === 'ja' && h.dataset.article && t.indexOf(pref) >= 0 && !/[?&]ja=1/.test(location.search))
          location.replace(h.dataset.base + pref + '/articles/' + h.dataset.article + '/' + (h.dataset.idx || ''));
      } catch (e) {}
    </script>
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-title" href={url('')}>
          {siteName}
          <small>過去問15年分をテーマ別に</small>
        </a>
        <label class="lang-select" data-noruby>
          <span aria-hidden="true">🌐</span>
          <select id="lang-select" aria-label="Language / 言語">
            {LANG_MENU.map((m) => <option value={m.code} selected={m.code === lang}>{m.label}</option>)}
          </select>
        </label>
      </div>
      <p class="lang-note" id="lang-note" hidden></p>
      <nav class="site-nav" aria-label="メニュー">
        <div class="wrap">
          <a href={url('guide/')}>🔰 {nav('guide', '使い方')}</a>
          <a href={url('')}>{nav('theme', 'テーマ別目次')}</a>
          <a href={url('subjects/')}>{nav('subject', '科目別目次')}</a>
          <a href={url('level/')}>{nav('level', '重要度別')}</a>
          <a href={url('ichimon/')}>{nav('ichimon', '1問1答')}</a>
          <a href={url('anki/')}>{nav('anki', '暗記シート')}</a>
          <a href={url('hikaku/')}>{nav('hikaku', '比較で覚える')}</a>
          <a href={url('moshi/')}>{nav('moshi', 'ミニ模試')}</a>
          <a href={url('mame/')}>{nav('mame', '豆知識・試験情報')}</a>
        </div>
      </nav>
    </header>
    <div class="layout">
      <Sidebar themeId={themeId} articleId={articleId} />
      <main class="main">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <div class="wrap">
        <p>過去問は第24〜38回の介護福祉士国家試験を分析して作成しています。問題文は要旨の言い換えです。</p>
        <p>制度は改正されることがあります。最新の情報は公的機関の資料もあわせて確認してください。</p>
      </div>
    </footer>
    <script is:inline define:vars={{ notes: Object.fromEntries(Object.entries(UI).map(([k, v]) => [k, v.notTranslated])) }}>
      // 言語の切り替え：日本語／ふりがな付き／英語・インドネシア語・フィリピン語・ベトナム語
      (function () {
        var h = document.documentElement, sel = document.getElementById('lang-select');
        var pref = 'ja'; try { pref = localStorage.getItem('lang') || 'ja'; } catch (e) {}
        var page = h.dataset.pageLang, trans = (h.dataset.trans || '').split(',').filter(Boolean);
        if (page === 'ja') sel.value = pref;
        function note(code) {
          var n = document.getElementById('lang-note');
          if (notes[code] && page === 'ja') { n.textContent = '🌐 ' + notes[code]; n.hidden = false; } else n.hidden = true;
        }
        if (page === 'ja' && notes[pref]) note(pref);
        sel.addEventListener('change', function () {
          var v = sel.value;
          try { localStorage.setItem('lang', v); } catch (e) {}
          if (v === 'ja' || v === 'ruby') {
            h.classList.toggle('ruby', v === 'ruby');
            if (page !== 'ja' && h.dataset.jaUrl) location.href = h.dataset.jaUrl;
            else note(v);
            return;
          }
          var id = h.dataset.article;
          if (page === 'ja' && id && trans.indexOf(v) >= 0) location.href = h.dataset.base + v + '/articles/' + id + '/' + (h.dataset.idx || '');
          else if (page !== 'ja' && h.dataset.jaUrl) {
            // 翻訳ページ同士の切り替え（その言語の翻訳がなければ日本語へ）
            var avail = (h.dataset.trans || '').split(',');
            location.href = avail.indexOf(v) >= 0 ? h.dataset.base + v + '/articles/' + id + '/' + (h.dataset.idx || '') : h.dataset.jaUrl + '?ja=1';
          } else note(v);
        });
      })();
    </script>
    <script is:inline>
      // ステップ式の図：「前へ」「次へ」で1枚ずつ表示する
      document.querySelectorAll('.steps').forEach(function (f) {
        var steps = f.querySelectorAll('.fstep'); if (steps.length < 2) return;
        var i = 0; f.classList.add('js');
        var nav = document.createElement('div'); nav.className = 'steps-nav';
        nav.innerHTML = '<button type="button" class="prev">◀ 前へ</button><div class="steps-dots"></div><button type="button" class="next">次へ ▶</button>';
        f.querySelector('.steps-body').after(nav);
        var dots = nav.querySelector('.steps-dots');
        steps.forEach(function () { dots.appendChild(document.createElement('span')); });
        function show(n) {
          i = n;
          steps.forEach(function (s, k) { s.classList.toggle('on', k === i); dots.children[k].classList.toggle('on', k === i); });
          nav.querySelector('.prev').disabled = i === 0;
          nav.querySelector('.next').textContent = i === steps.length - 1 ? '最初から ↺' : '次へ ▶';
        }
        nav.querySelector('.prev').onclick = function () { if (i > 0) show(i - 1); };
        nav.querySelector('.next').onclick = function () { show(i === steps.length - 1 ? 0 : i + 1); };
        show(0);
      });
    </script>
  </body>
</html>
