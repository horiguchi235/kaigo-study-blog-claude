---
// 左の固定目次（スマホでは「目次」ボタンで開く）。テーマ別・科目別・重要度別をタブで切り替える
import { getArticles } from '../data/articles';
import { categories, subjects, themeIdOf, levelOf, LEVELS, shortTitle, url } from '../data/taxonomy';
import { roadmap } from '../data/nav';

interface Props { themeId?: string; articleId?: string }
const { themeId, articleId } = Astro.props;
const articles = await getArticles();
const road = roadmap(articles);
const byTheme = (id: string) => articles.filter((a) => themeIdOf(a.data.theme) === id);
const extra = articles.filter((a) => ['Y', 'Z'].includes(themeIdOf(a.data.theme)));
const current = articles.find((a) => a.id === articleId);
const byLevel = [3, 2, 1].map((lv) => ({ lv, list: road.filter((a) => !['Y', 'Z'].includes(themeIdOf(a.data.theme)) && levelOf(themeIdOf(a.data.theme)) === lv) }));
---

<aside class="side" id="side" aria-label="目次">
  <div class="side-inner">
    <div class="side-head">
      <span>目次</span>
      <button type="button" class="side-close" aria-label="目次を閉じる" title="目次を閉じる"><span class="pc">« 閉じる</span><span class="sp">×</span></button>
    </div>
    <a class="side-guide" href={url('guide/')}>🔰 このサイトの使い方</a>
    <a class="side-mylist" href={url('mylist/')}>⭐ マイリスト</a>
    <p class="side-done" id="side-done" hidden><label><input type="checkbox" id="hide-done" /> ✅ 完璧にした記事をかくす</label> <small id="side-done-n"></small></p>
    <div class="side-tabs" role="tablist">
      <button type="button" role="tab" aria-selected="true" data-pane="theme">テーマ別</button>
      <button type="button" role="tab" aria-selected="false" data-pane="subject">科目別</button>
      <button type="button" role="tab" aria-selected="false" data-pane="level">重要度別</button>
    </div>

    <div class="side-pane" data-pane="theme">
      {
        categories.map((c) => {
          const here = c.themes.some((t) => t.id === themeId);
          return (
            <details class="side-cat" open={here}>
              <summary><span class="step">STEP {c.no}</span><span>{c.name.replace(/（.*）/, '')}</span></summary>
              <ul>
                {c.themes.map((t) => {
                  const list = byTheme(t.id);
                  const on = t.id === themeId;
                  return (
                    <li class={on ? 'on' : ''} data-arts={list.map((a) => a.id).join(',')}>
                      {list.length ? <a href={url(`articles/${list[0].id}/`)}>{t.name}</a> : <span class="soon">{t.name}</span>}
                      <span class={`lv lv${levelOf(t.id)}`} title={LEVELS[levelOf(t.id)].label}>{LEVELS[levelOf(t.id)].stars}</span>
                      {on && (
                        <ul class="side-arts">
                          {list.map((a) => (
                            <li class={a.id === articleId ? 'cur' : ''}>
                              <a href={url(`articles/${a.id}/`)}>{a.data.article.replace(/^.*?([①-⑩])$/, '$1')} {shortTitle(a.data.title)}</a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  );
                })}
              </ul>
            </details>
          );
        })
      }
      {
        extra.length > 0 && (
          <details class="side-cat" open={['Y', 'Z'].includes(themeId ?? '')}>
            <summary><span class="step alt">＋</span><span>比較・豆知識・試験情報</span></summary>
            <ul>
              {extra.map((a) => (
                <li class={a.id === articleId ? 'on' : ''}><a href={url(`articles/${a.id}/`)}>{shortTitle(a.data.title)}</a></li>
              ))}
            </ul>
          </details>
        )
      }
    </div>

    <div class="side-pane" data-pane="subject" hidden>
      {
        subjects.map((s) => {
          const list = road.filter((a) => a.data.subjects.includes(s.name));
          return (
            <details class="side-cat" data-subj={s.slug}>
              <summary><span>{s.name}</span></summary>
              <ul class="side-arts">
                <li><a href={url(`subjects/${s.slug}/`)}>📋 {s.name}の目次ページ</a></li>
                {list.map((a) => (
                  <li class={a.id === articleId ? 'cur' : ''}>
                    <a href={url(`articles/${a.id}/`) + `?from=s-${s.slug}`}>{shortTitle(a.data.title)}</a>
                  </li>
                ))}
              </ul>
            </details>
          );
        })
      }
    </div>

    <div class="side-pane" data-pane="level" hidden>
      {
        byLevel.map(({ lv, list }) => (
          <details class="side-cat" data-lv={lv} open={lv === 3}>
            <summary><span class={`lv lv${lv}`}>{LEVELS[lv].stars}</span><span>{LEVELS[lv].label}（{list.length}記事）</span></summary>
            <ul class="side-arts">
              {list.map((a) => (
                <li class={a.id === articleId ? 'cur' : ''}>
                  <a href={url(`articles/${a.id}/`) + '?from=lv'}>{shortTitle(a.data.title)}</a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </div>
</aside>
<button type="button" class="side-open" aria-controls="side">☰ 目次</button>
<script is:inline>
  (function () {
    var side = document.getElementById('side');
    // パソコンでは目次をたたんで本文を広く使える（状態は覚えておく）
    var wide = function () { return window.innerWidth >= 1080; };
    var root = document.documentElement;
    document.querySelector('.side-open').onclick = function () {
      if (wide()) { root.classList.remove('side-collapsed'); try { localStorage.setItem('sideCollapsed', ''); } catch (e) {} }
      else side.classList.add('open');
    };
    side.querySelector('.side-close').onclick = function () {
      if (wide()) { root.classList.add('side-collapsed'); try { localStorage.setItem('sideCollapsed', '1'); } catch (e) {} }
      else side.classList.remove('open');
    };
    side.addEventListener('click', function (e) { if (e.target === side) side.classList.remove('open'); });
    var tabs = side.querySelectorAll('.side-tabs button'), panes = side.querySelectorAll('.side-pane');
    function show(name) {
      tabs.forEach(function (t) { t.setAttribute('aria-selected', t.dataset.pane === name ? 'true' : 'false'); });
      panes.forEach(function (p) { p.hidden = p.dataset.pane !== name; });
      try { localStorage.setItem('sideTab', name); } catch (e) {}
    }
    tabs.forEach(function (t) { t.onclick = function () { show(t.dataset.pane); }; });
    // 科目別の目次から来たときは、科目別タブでその科目を開いておく
    var from = new URLSearchParams(location.search).get('from');
    try { if (from === null) from = sessionStorage.getItem('navFrom'); } catch (e) {}
    if (from && from.indexOf('s-') === 0) {
      var d = side.querySelector('[data-subj="' + from.slice(2) + '"]');
      if (d) d.open = true;
      show('subject');
    } else if (from === 'lv') {
      show('level');
    } else {
      var saved = null; try { saved = localStorage.getItem('sideTab'); } catch (e) {}
      if ((saved === 'subject' || saved === 'level') && !side.querySelector('[data-pane="theme"] li.on')) show(saved);
    }
    var cur = side.querySelector('.side-pane:not([hidden]) .cur, .side-pane:not([hidden]) li.on');
    // 今の記事が見えるように、目次の箱の中だけをスクロールする（ページ全体は動かさない）
    if (cur && window.innerWidth >= 1080) {
      var box = side;
      var bt = box.getBoundingClientRect().top, ct = cur.getBoundingClientRect().top;
      box.scrollTop += ct - bt - box.clientHeight / 2 + cur.offsetHeight / 2;
    }
    // スマホ：下へスクロール中は「☰ 目次」ボタンを引っこめ、上へ戻すと出す（本文に重ならないように）
    var ob = document.querySelector('.side-open'), lastY = window.scrollY;
    window.addEventListener('scroll', function () {
      var y = window.scrollY;
      if (Math.abs(y - lastY) < 6) return;
      ob.classList.toggle('away', y > lastY && y > 200);
      lastY = y;
    }, { passive: true });
  })();
</script>
